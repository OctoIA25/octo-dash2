# Supabase (CRM-MULTITENANT)
# IMPORTANTE: Use a chave JWT legacy (começa com eyJ...), NÃO a chave publishable (sb_publishable_...)
VITE_SUPABASE_URL=https://glbtwvusiaaovllxhiig.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdsYnR3dnVzaWFhb3ZsbHhoaWlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgzMjk5ODMsImV4cCI6MjA4MzkwNTk4M30.7Y7JP2XRQdCWYMA5wf6omEXrxU6azYL7hkJ4eiTm6rQ

# Service Role Key (para o servidor - bypassa RLS)
# Obtenha em: https://supabase.com/dashboard/project/glbtwvusiaaovllxhiig/settings/api
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth (Octo Agenda - multitenant)
# 1. Crie credenciais OAuth 2.0 em: https://console.cloud.google.com/apis/credentials
# 2. Em "URIs de redirecionamento autorizados" adicione:
#    - Desenvolvimento: http://localhost:8080/oauth/google/callback
#    - Produção: https://SEU_DOMINIO/oauth/google/callback
# 3. Em "Origens JavaScript autorizadas": http://localhost:8080 e sua origem de produção
VITE_GOOGLE_CALENDAR_CLIENT_ID=
VITE_GOOGLE_CALENDAR_CLIENT_SECRET=

# Santa Ângela — sync automático (polling server-side). Ligar em UM processo.
# A config (base_url + api_key cifrada) vive POR TENANT em tenant_santa_angela_config.
# Não há mais key global por ENV: cada tenant cadastra a sua no painel de Integrações.
SANTA_ANGELA_SYNC_SCHEDULER=0          # 1 para ativar o cron de polling
SANTA_ANGELA_SYNC_CRON=* * * * *       # default: a cada 60s (frescor p/ time de IA)
SANTA_ANGELA_SYNC_CONCURRENCY=5        # tenants sincronizados em paralelo por ciclo
SANTA_ANGELA_TENANT_TIMEOUT_MS=60000   # teto por tenant; estourou → erro no ciclo, não bloqueia os demais
SANTA_ANGELA_HTTP_TIMEOUT_MS=15000     # timeout por requisição à API Santa Ângela

# Integração Zap/OLX VRSync (feed XML de imóveis)
# A config (feed_secret, contato, resync) vive POR TENANT em tenant_zap_config,
# cifrada (AES-256-GCM). Não há mais secret/tenant global por ENV: cada tenant
# cadastra o seu secret no painel de Integrações. (Os ZAPIMOVEIS_CONTACT_*/PROVIDER/
# PUBLICATION_TYPE/DETAIL_BASE_URL ainda servem só como default de conteúdo do feed.)

# CORS: origens permitidas (separadas por vírgula). Default: http://localhost:8080
CORS_ORIGINS=

# Modo demo da API (Authorization: Bearer demo)
# A chave "demo" fica restrita a ESTE tenant — nunca pode ler outros tenants.
# Deixe em branco para manter o modo demo DESABILITADO (recomendado em produção).
DEMO_TENANT_ID=

# ──────────────────────────────────────────────────────────────────────────
# Recomendações de imóveis por e-mail
# ──────────────────────────────────────────────────────────────────────────
# Ambiente lógico do envio. Precedência: APP_ENV > NODE_ENV > 'development'.
# SOMENTE em 'production' os e-mails vão para o lead real; em qualquer outro
# valor (development/homologation/staging) tudo é redirecionado para o e-mail
# de teste — proteção contra disparo acidental para clientes reais.
APP_ENV=development

# E-mail de teste que recebe TODOS os envios fora de produção (e os "envios de
# teste"). Pode ser sobrescrito por tenant nas Configurações. Fallback embutido:
EMAIL_TEST_RECIPIENT=

# Remetente exibido no e-mail (From).
EMAIL_FROM="Recomendações <nao-responda@octodash.local>"

# SMTP GLOBAL (fallback). Cada imobiliária pode ter seu PRÓPRIO SMTP em
# Configurações → Recomendações (recomendado, multi-tenant). O SMTP abaixo é
# usado apenas quando o tenant não tem SMTP próprio. Sem SMTP_HOST nem SMTP do
# tenant, o servidor usa o transporte SIMULADO (não envia de fato).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Chave-mestra (32 bytes em base64) para cifrar a senha SMTP de cada tenant
# em repouso (AES-256-GCM). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA versione. Trocar a chave invalida as senhas já salvas (basta re-salvar).
EMAIL_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Agendamento de recomendações (Fase 2)
# ──────────────────────────────────────────────────────────────────────────
# Ativa o worker que processa agendamentos vencidos. Habilite em UM ÚNICO
# processo/instância (evita execuções duplicadas em cluster). A idempotência
# protege contra duplicidade, mas rodar em 1 processo é a recomendação.
RECOMMENDATION_SCHEDULER=0
# Frequência da varredura (cron). Default: de hora em hora.
RECOMMENDATION_SCHEDULER_CRON=0 * * * *

# --- Kenlo (sync nativo de leads — substitui automação N8N) ---
KENLO_SYNC_SCHEDULER=0            # 1 = liga o cron em ESTE processo (apenas um)
KENLO_SYNC_SCHEDULER_CRON=*/3 * * * *
KENLO_HTTP_RETRIES=3
KENLO_HTTP_TIMEOUT_MS=15000
KENLO_PER_PAGE=200
# Credenciais por tenant ficam CIFRADAS em kenlo_integrations (usa EMAIL_ENCRYPTION_KEY).